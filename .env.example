# Copy this file to .env and fill it in:   cp .env.example .env && chmod 600 .env
# NEVER share .env or upload it anywhere. It is listed in .gitignore.

# Anthropic Console > API keys (use the "MAAI Agents" workspace)
ANTHROPIC_API_KEY=

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram id. Leave empty at first; the bot tells you what it is.
TELEGRAM_OWNER_ID=

# Where TEST emails go in practice mode (your own address)
OWNER_EMAIL=

# Google connection (see docs/SETUP.md, step 3)
GOOGLE_CLIENT_SECRET_FILE=data/google_client_secret.json
GOOGLE_TOKEN_FILE=data/google_token.json
# The long id in your template's link: docs.google.com/document/d/<THIS PART>/edit
GOOGLE_INVOICE_TEMPLATE_ID=
