# Copia este archivo como ".env" y llena los datos.  (cp .env.example .env)
# NUNCA subas el archivo .env a GitHub ni lo compartas: tiene tus contraseñas.

# ===== 1) IA (Claude) =====
# Crea la clave en https://console.anthropic.com  ->  API Keys  (hay que cargar saldo; cada invoice cuesta centavos)
ANTHROPIC_API_KEY=

# ===== 2) Gmail: donde se guardan los BORRADORES =====
GMAIL_USER=maaicleaning@gmail.com
# "Contraseña de aplicación" de 16 letras: https://myaccount.google.com/apppasswords
# (requiere tener activada la verificación en 2 pasos en esa cuenta de Google)
GMAIL_APP_PASSWORD=

# ===== 3) Seguridad: quién puede usar el bot =====
# Inventa un código. Desde el WhatsApp de tu jefa se manda UNA vez:  activar ESTE-CODIGO
CODIGO_ACCESO=
# (Opcional) Números que pueden usarlo sin código, con código de país y sin "+", separados por coma. Ej: 17705551234
NUMEROS_PERMITIDOS=

# ===== 4) WhatsApp =====
WHATSAPP=si
# (Opcional) Si no puedes escanear el QR, pon aquí el número del BOT (ej. 17705551234) y te dará un código para vincular.
WHATSAPP_NUMERO_BOT=

# ===== 5) (Opcional) Telegram como plan B (más fácil y sin riesgo de bloqueo) =====
# Token que te da @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# ===== Avanzado (normalmente no se toca) =====
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_FALLBACK=default
# IMAP_HOST=imap.gmail.com
# DATA_DIR=data
